{
  "name": "visnex-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run typecheck:api && npm run build:api && vite build",
    "build:api": "tsc -p apps/api/tsconfig.build.json",
    "start": "node dist-api/apps/api/src/server.js",
    "preview": "vite preview",
    "images": "node scripts/prepare-images.mjs",
    "api:dev": "tsx watch apps/api/src/server.ts",
    "api:start": "tsx apps/api/src/server.ts",
    "typecheck:api": "tsc -p apps/api/tsconfig.json",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "tsx --test packages/configurator-core/test/*.test.ts",
    "test:api": "tsx --test apps/api/test/*.test.ts",
    "test:e2e": "node scripts/test-modular-configurator.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.0",
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource-variable/manrope": "^5.2.5",
    "@fontsource-variable/playfair-display": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.5",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "framer-motion": "^11.18.2",
    "lenis": "^1.3.25",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^26.1.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^4.4.1",
    "playwright-core": "^1.61.1",
    "sharp": "^0.34.1",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
