API_HOST=127.0.0.1
API_PORT=8787
DATASTORE=sqlite
DATABASE_PATH=./data/configurator.sqlite
# PostgreSQL (włącz dopiero po migracji danych):
# DATASTORE=postgres
# DATABASE_URL=postgresql://user:password@host:5432/database
# DATABASE_SSL_MODE=disable
PUBLIC_APP_URL=http://localhost:5173/konfigurator.html
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_SEED_EMAIL=admin@example.invalid
ADMIN_SEED_PASSWORD=replace-with-a-long-local-password
SESSION_TTL_HOURS=12
DEFAULT_TENANT_SLUG=visnex
# Opcjonalnie: klient.example.com=klient-a,drugi.example.com=klient-b
TENANT_HOST_MAP=
VITE_API_BASE_URL=http://127.0.0.1:8787
# Railway (jedna usługa): VITE_API_BASE_URL=same-origin

# Jednorazowy onboarding operatorski (ustaw tymczasowo i usuń po wykonaniu):
# NEW_TENANT_NAME=Firma Klienta
# NEW_TENANT_ADMIN_EMAIL=admin@firma.example
# NEW_TENANT_ADMIN_PASSWORD=replace-with-a-different-strong-password
# NEW_TENANT_DOMAINS=konfigurator.firma.example
